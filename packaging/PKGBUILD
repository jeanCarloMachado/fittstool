# Maintainer: Eric Bakker <musqz at mf dot com>
pkgname=fittsmon
pkgver=1.3.0
pkgrel=1
pkgdesc="Lightweight X11/Wayland utility to bind mouse actions to screen corners and edges (multi-monitor)"
arch=('x86_64')
url="https://github.com/musqz/fittsmon"
license=('GPL-2.0-or-later')
depends=('glib2' 'libx11' 'libxcb' 'wayland')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('5dae385022e04fd560ec8722477a959e12ce600d906136ae2fa847f4bb9e0362')

build() {
    cd "${pkgname}-${pkgver}"
    make
}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR="${pkgdir}" PREFIX=/usr install
}
